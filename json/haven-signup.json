t, init) {\n      var promise = realFetch.apply(this, arguments);\n      var url = typeof input === \"string\" ? input : input && input.url;\n      if (url && /\\/v1\\/flow\\/[^/]+\\/records/.test(url)) {\n        promise\n          .then(function (res) { return res.clone().json(); })\n          .then(function (body) {\n            ((body && body.result && body.result.records) || []).forEach(function (r) {\n              recordNames[r.recordID] = r;\n            });\n          })\n          .catch(function () {});\n      }\n      return promise;\n    };\n\n    var started = Date.now();\n    var userTouched = false;\n    var automating = false;\n    document.addEventListener(\n      \"pointerdown\",\n      function (e) {\n        if (!automating && e.isTrusted && e.target.closest && e.target.closest(\".fillout-field-record-picker\")) userTouched = true;\n      },\n      true\n    );\n\n    realFetch(ENDPOINT, { credentials: \"omit\" })\n      .then(function (res) { return res.ok ? res.json() : null; })\n      .then(function (event) {\n        log(\"nearest\", event);\n        if (!event || !event.id) return;\n        if (event.distanceKm > MAX_DISTANCE_KM) return log(\"skip: too far\");\n        return choose(event);\n      })\n      .catch(function (err) { log(\"failed\", err); });\n\n    function hasSavedProgress() {\n      try {\n        var flowId = currentFlowId();\n        var models = JSON.parse(localStorage.getItem(\"__live_models_v1\") || \"{}\");\n        return Object.keys(models).some(function (key) {\n          if (flowId && key.indexOf(flowId + \"_\") !== 0) return false;\n          var model = models[key] || {};\n          // Steps hold the answers; anything else is bookkeeping.\n          return Object.keys(model).some(function (stepId) {\n            if (/^(urlParams|stepHistory|calculations|globals|quiz)$/.test(stepId)) return false;\n            return hasAnswer(model[stepId]);\n          });\n        });\n      } catch (e) {\n        return false;\n      }\n    }\n\n    function hasAnswer(step) {\n      if (!step || typeof step !== \"object\") return false;\n      return Object.keys(step).some(function (widgetId) {\n        var v = step[widgetId];\n        if (v && typeof v === \"object\" && \"value\" in v) v = v.value;\n        if (v == null || v === \"\" || v === false) return false;\n        if (Array.isArray(v)) return v.length > 0;\n        if (typeof v === \"object\") return Object.keys(v).some(function (k) { return v[k] != null && v[k] !== \"\"; });\n        return true;\n      });\n    }\n\n    function currentFlowId() {\n      try {\n        var data = JSON.parse(document.getElementById(\"__NEXT_DATA__\").textContent);\n        return data.props.pageProps.flow.publicIdentifier;\n      } catch (e) {\n        return null;\n      }\n    }\n\n    function sleep(ms) {\n      return new Promise(function (r) { setTimeout(r, ms); });\n    }\n\n    function waitFor(fn, timeout) {\n      return new Promise(function (resolve, reject) {\n        var until = Date.now() + (timeout || 8000);\n        (function tick() {\n          var v = fn();\n          if (v) return resolve(v);\n          if (Date.now() > until) return reject(new Error(\"timed out\"));\n          setTimeout(tick, 100);\n        })();\n      });\n    }\n\n    function pickerButton() {\n      return document.querySelector(\".fillout-field-record-picker [data-cy=record-picker-component]\");\n    }\n\n    function pickerHasValue() {\n      return !!document.querySelector(\".fillout-field-record-picker [data-cy=record-picker-selected-value]\");\n    }\n\n    function popup() {\n      return document.querySelector(\"[data-cy=record-picker-popup]\");\n    }\n\n    function setInput(input, value) {\n      var setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, \"value\").set;\n      setter.call(input, value);\n      input.dispatchEvent(new Event(\"input\", { bubbles: true }));\n    }\n\n    function closePopup() {\n      var p = popup();\n      var close = p && p.parentElement && p.parentElement.querySelector(\"[aria-label='Close dropdown selection']\");\n      if (!close) close = document.querySelector(\"[aria-label='Close dropdown selection']\");\n      if (close) close.click();\n    }\n\n    async function choose(event) {\n      var button = await waitFor(pickerButton, Math.max(0, GIVE_UP_MS - (Date.now() - started)));\n      // Give the form a beat to settle: a \"resume?\" prompt or ?event= prefill\n      // can land a moment after the picker first renders.\n      await sleep(300);\n      if (userTouched || pickerHasValue()) return log(\"skip: picker already in use\");\n      if (Date.now() - started > GIVE_UP_MS) return log(\"skip: too slow\");\n\n      var style = document.createElement(\"style\");\n      style.textContent = \"[data-cy=record-picker-popup]{visibility:hidden!important}\";\n      document.head.appendChild(style);\n      var scrollX = window.scrollX, scrollY = window.scrollY;\n      automating = true;\n\n      try {\n        button.click();\n        var p = await waitFor(popup, 5000);\n        var search = p.querySelector(\"input\");\n        setInput(search, event.name);\n\n        // Wait for the search to come back with our record, then click the\n        // option showing that record's name.\n        var record = await waitFor(function () { return recordNames[event.id]; }, 8000);\n        var label = record[\"_Full Display Name\"] || record[\"_Fillout Display Name\"] || event.name;\n        var option = await waitFor(function () {\n          var p = popup();\n          if (!p) return null;\n          return [].slice.call(p.querySelectorAll(\"[tabindex='0']\")).find(function (el) {\n            return el.textContent.trim() === label;\n          });\n        }, 5000);\n\n        if (userTouched) throw new Error(\"visitor took over\");\n        option.click();\n        log(\"chose\", label);\n      } catch (err) {\n        log(\"gave up\", err);\n        if (popup()) closePopup();\n      } finally {\n        automating = false;\n        // Let the popup finish closing (it refocuses the picker button on the\n        // way out) before tidying up after it.\n        setTimeout(function () {\n          var focused = document.activeElement;\n          if (focused && focused.closest && focused.closest(\".fillout-field-record-picker\")) focused.blur();\n          window.scrollTo(scrollX, scrollY);\n          style.remove();\n        }, 300);\n      }\n    }\n  })();\n</script>\n"},"firstStep":"2oBf","urlParams":["email","first_name","last_name","event","r","ref"],"calculations":{},"integrations":{"fN8y":{"serviceId":517659,"writeQuery":{"id":"m4uX","config":{"view":"","baseId":"appc9YSRmmAmLI37u","filters":[{"key":"","value":{"logic":{},"expectedTypes":["any"],"___LOGIC_TYPE___":"picker"},"condition":"="}],"tableId":"tblFV1bwpg8vheHHv","columnId":"","mappings":[{"key":"fldVhQErTfE45Pj3s","value":{"logic":{"joinArrayFields":[{"var":"2oBf['o8rU'].value"},"recordID"]},"expectedTypes":["any"],"___LOGIC_TYPE___":"picker"}},{"key":"fldYT9mhPeCBnBH44","value":{"logic":{"var":"2oBf['xhVc'].value"},"expectedTypes":["any"],"___LOGIC_TYPE___":"picker"}},{"key":"fldMtf95MOSMmVBFJ","value":{"logic":{"var":"2oBf['jwvK'].value"},"expectedTypes":["any"],"___LOGIC_TYPE___":"picker"}},{"key":"fldHPDe87g0zSApiS","value":{"logic":{"var":"2oBf['b4fd'].value"},"expectedTypes":["any"],"___LOGIC_TYPE___":"picker"}},{"key":"fld9cd0Ev0s5Xfr9a","value":{"logic":{"stringLiteral":"Participant"},"expectedTypes":["any"],"___LOGIC_TYPE___":"picker"}},{"key":"fldPd1auclpzhOIdV","value":{"logic":{"var":"2oBf['1e7c'].value"},"expectedTypes":["any"],"___LOGIC_TYPE___":"picker"}},{"key":"fldERxe8TQGDUdwRY","value":{"logic":{"var":"2oBf['ubdK'].value"},"expectedTypes":["any"],"___LOGIC_TYPE___":"picker"}},{"key":"fldk4Ym6Vpus1N0Eb","value":{"logic":{"var":"2oBf['rYnf'].value"},"expectedTypes":["any"],"___LOGIC_TYPE___":"picker"}},{"key":"fldKChNYKQPJJmpEc","value":{"logic":{"var":"